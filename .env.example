# Copy to .env (never commit .env). Placeholders only: do not put real secrets in this file.

# ---- Environment -------------------------------------------------------------------------------
# development (default) shows demo controls; production hides them.
CIVICFIX_ENV=development
# OIDC role claim to read from the verified identity token (expected values: citizen, reviewer, operator, admin).
CIVICFIX_OIDC_ROLE_CLAIM=civicfix_role

# ---- Storage -----------------------------------------------------------------------------------
# MongoDB Atlas (recommended for any deployment that must keep data). If MONGODB_URI is set it is used,
# and a failed connection is an ERROR (the app never silently falls back to a local file).
# Atlas: Connect > Drivers > copy the mongodb+srv:// string, then put the DB user's password in it.
MONGODB_URI=
MONGODB_DATABASE=civicfix
# MONGODB_TIMEOUT_MS=5000

# Local SQLite file, used ONLY when MONGODB_URI is empty (development / offline demo).
CIVICFIX_DB_PATH=data/civicfix.db

# ---- Demo data ---------------------------------------------------------------------------------
# Fictional sample reports are never loaded automatically unless you opt in:
CIVICFIX_AUTO_SEED=false
# Sidebar demo controls (default: on in development, off in production)
# CIVICFIX_ENABLE_DEMO_CONTROLS=true

# ---- Optional AI draft polishing ---------------------------------------------------------------
# Leave empty for fully offline, deterministic mode. If set, the complaint's category, location, priority and
# description are sent over the internet to Anthropic to polish the draft letter. Output is validated.
ANTHROPIC_API_KEY=
# Unchanged default; verify it against the models your account can use before enabling a key.
CIVICFIX_LLM_MODEL=claude-sonnet-5-5

# ---- Follow-up agent ---------------------------------------------------------------------------
FOLLOWUP_THRESHOLD_DAYS=3
