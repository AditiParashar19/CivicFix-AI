# Copy to .streamlit/secrets.toml and replace every placeholder. Never commit the real file.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "<generate-a-long-random-secret>"
client_id = "<oidc-client-id>"
client_secret = "<oidc-client-secret>"
server_metadata_url = "<https://your-identity-provider/.well-known/openid-configuration>"
